<Window x:Class="R1ng.Launcher.HiddenItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已隐藏的项目"
        Width="580"
        Height="440"
        MinWidth="440"
        MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="已隐藏的项目">

    <Window.Resources>
        <!-- Colours come from the same swappable palette as the launcher (DynamicResource). -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="6" Background="{DynamicResource FooterButtonBackgroundBrush}"
                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ButtonOutline" CornerRadius="6" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ChipHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenRowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBackground" CornerRadius="8" Background="Transparent" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="RowOutline" CornerRadius="8" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HiddenRowTemplate">
            <Grid ToolTip="{Binding Target}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TypeBadgeBackgroundBrush}"
                            CornerRadius="6"
                            Padding="7,2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Border>
                    <Button Content="恢复"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnRestoreClick"
                            AutomationProperties.Name="{Binding RestoreAutomationName}"
                            ToolTip="恢复后该项会重新出现在搜索结果和最近使用中" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header (drag handle) -->
                <Border x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Padding="18,14,18,6">
                    <StackPanel>
                        <TextBlock Text="已隐藏的项目"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="CountText"
                                   Margin="0,3,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="隐藏的项目不会出现在搜索结果和最近使用中；历史、置顶和排序数据不受影响。" />
                    </StackPanel>
                </Border>

                <!-- Store/restore diagnostics use the launcher's independent transient notice. -->
                <!-- List and empty state -->
                <Grid Grid.Row="1" Margin="8,8,8,0">
                    <ListBox x:Name="RowsList"
                             ItemTemplate="{StaticResource HiddenRowTemplate}"
                             ItemContainerStyle="{StaticResource HiddenRowStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.Name="已隐藏的项目列表" />
                    <TextBlock x:Name="EmptyText"
                               Text="没有已隐藏的项目"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="16,10,16,14">
                    <Button x:Name="RestoreAllButton"
                            Content="恢复全部"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnRestoreAllClick"
                            AutomationProperties.Name="恢复全部"
                            ToolTip="恢复所有已隐藏的项目" />
                    <Button x:Name="CloseButton"
                            Content="关闭"
                            Margin="10,0,0,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="关闭已隐藏的项目窗口" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
