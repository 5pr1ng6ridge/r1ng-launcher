<Window x:Class="R1ng.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:R1ng.Launcher.Controls"
        xmlns:converters="clr-namespace:R1ng.Launcher.Converters"
        Title="R1ng Launcher"
        Icon="pack://application:,,,/R1ngLauncher;component/app.ico"
        Width="760"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!--
            All colours come from the swappable palette installed by ThemeManager (Theming/
            ThemePalette.cs) through DynamicResource, so changing the theme repaints the live UI.
        -->

        <Style x:Key="QuickToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="ToggleBorder" CornerRadius="5" Background="Transparent" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ToggleOutline" CornerRadius="5" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ToggleCheckedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral header action used by the temporary Notepad editing menu. -->
        <Style x:Key="EditorActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ActionButtonBorder" CornerRadius="6" Background="{DynamicResource FooterButtonBackgroundBrush}"
                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActionOutline" CornerRadius="6" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeToggleStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ThemeButtonBorder" CornerRadius="7" Background="Transparent" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ThemeOutline" CornerRadius="7" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ThemeButtonBorder" Property="Background" Value="{DynamicResource ToggleHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinnedTileStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="TileBorder" CornerRadius="8" Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="TileOutline" CornerRadius="8" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ResultSelectedBackgroundBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ResultSelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBackground" CornerRadius="8" Background="Transparent" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="RowOutline" CornerRadius="8" Style="{DynamicResource HoverOutlineStyle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ResultSelectedBackgroundBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource ResultSelectedBackgroundBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Image Source="{Binding Icon}"
                           Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock controls:TitleHighlighter.Text="{Binding Title}"
                               controls:TitleHighlighter.MatchIndices="{Binding Model.TitleMatchIndices}"
                               controls:TitleHighlighter.HighlightBrush="{DynamicResource HighlightBrush}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource TypeBadgeBackgroundBrush}" CornerRadius="6" Padding="7,2">
                        <TextBlock Text="{Binding TypeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Border>
                </StackPanel>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Command="{Binding OpenCommand}" InputGestureText="Enter" />
                        <MenuItem Header="打开所在位置" Command="{Binding OpenContainingFolderCommand}" InputGestureText="Ctrl+Enter" />
                        <MenuItem Header="QuickLook 预览" Command="{Binding PreviewCommand}" InputGestureText="Ctrl+Space" />
                        <Separator />
                        <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+C" />
                        <MenuItem Header="{Binding PinHeader}" Command="{Binding TogglePinCommand}" />
                        <MenuItem Header="隐藏此项" Command="{Binding HideCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PinnedTileTemplate">
            <Button Style="{StaticResource PinnedTileStyle}"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTip="{Binding Title}"
                    PreviewMouseLeftButtonDown="OnPinnedTilePreviewMouseLeftButtonDown"
                    GotKeyboardFocus="OnPinnedTileGotKeyboardFocus"
                    Click="OnPinnedTileClick">
                <Grid Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Command="{Binding OpenCommand}" InputGestureText="Enter" />
                        <MenuItem Header="打开所在位置" Command="{Binding OpenContainingFolderCommand}" InputGestureText="Ctrl+Enter" />
                        <MenuItem Header="QuickLook 预览" Command="{Binding PreviewCommand}" InputGestureText="Ctrl+Space" />
                        <Separator />
                        <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+C" />
                        <MenuItem Header="{Binding PinHeader}" Command="{Binding TogglePinCommand}" />
                        <MenuItem Header="隐藏此项" Command="{Binding HideCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Border x:Name="CardBorder"
                CornerRadius="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search box -->
                <Grid x:Name="SearchHeader" Grid.Row="0" Margin="16,14,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Margin="2,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="搜索应用和文件…"
                                   FontSize="19"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="19"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 VerticalContentAlignment="Center"
                                 SpellCheck.IsEnabled="False"
                                 Style="{x:Null}" />
                    </Grid>

                    <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="EditingButton"
                                Content="编辑中"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource EditorActionButtonStyle}"
                                Click="OnEditingButtonClick"
                                AutomationProperties.Name="记事本编辑中">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="EditingMenu">
                                    <MenuItem x:Name="ApplySavedMenuItem" Header="应用已保存内容"
                                              Click="OnApplySavedEditorTextClick" IsEnabled="False" />
                                    <MenuItem x:Name="EndEditingMenuItem" Header="结束编辑" Click="OnEndEditingClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="ThemeToggleButton"
                                Content="{Binding ThemeToggleGlyph}"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource ThemeToggleStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                Click="OnThemeToggleClick"
                                AutomationProperties.Name="{Binding ThemeToggleAutomationName}" />
                    </StackPanel>
                </Grid>

                <!-- Two scope icons represent the existing three modes; file-search flags stay on the right. -->
                <Grid Grid.Row="1" Margin="16,2,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ApplicationsScopeToggle" Content="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Style="{StaticResource QuickToggleStyle}" IsChecked="{Binding IsApplicationsIncluded, Mode=TwoWay}"
                                      AutomationProperties.Name="搜索应用" ToolTip="应用&#x0a;双选表示全部，单选表示仅应用或仅文件" />
                        <ToggleButton x:Name="FilesScopeToggle" Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Style="{StaticResource QuickToggleStyle}" IsChecked="{Binding IsFilesIncluded, Mode=TwoWay}"
                                      AutomationProperties.Name="搜索文件" ToolTip="文件&#x0a;双选表示全部，单选表示仅应用或仅文件" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True">
                        <ToggleButton Content="Aa" IsChecked="{Binding IsMatchCase, Mode=TwoWay}"
                                      Style="{StaticResource QuickToggleStyle}" AutomationProperties.Name="区分大小写"
                                      ToolTip="区分大小写 (Aa)&#x0a;仅影响文件搜索结果；应用匹配始终不区分大小写" />
                        <ToggleButton IsChecked="{Binding IsMatchWholeWord, Mode=TwoWay}"
                                      IsEnabled="{Binding IsWholeWordOptionEnabled}"
                                      Style="{StaticResource QuickToggleStyle}" AutomationProperties.Name="全字匹配"
                                      ToolTip="全字匹配 (Abl)&#x0a;仅影响文件搜索结果；正则模式下不可用（Everything 会忽略）">
                            <TextBlock Text="Abl" FontSize="10.5" TextDecorations="Underline, Overline" />
                        </ToggleButton>
                        <ToggleButton Content="..\" IsChecked="{Binding IsMatchPath, Mode=TwoWay}"
                                      Style="{StaticResource QuickToggleStyle}" AutomationProperties.Name="匹配路径"
                                      ToolTip="匹配路径 (..\)&#x0a;在完整路径中搜索，而不仅是文件名（仅文件搜索）" />
                        <ToggleButton Content=".*" FontWeight="Bold" IsChecked="{Binding IsRegex, Mode=TwoWay}"
                                      Style="{StaticResource QuickToggleStyle}" AutomationProperties.Name="正则表达式"
                                      ToolTip="正则表达式 (.*)&#x0a;将查询作为 Everything 正则表达式（仅文件搜索）" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="2" VerticalAlignment="Bottom" Margin="16,0,16,4">
                    <ProgressBar IsIndeterminate="True"
                                 Height="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </Border>

                <!-- Diagnostics are transient independent windows, never inline or part of card sizing. -->
                <!-- Search results retain their virtualized viewport; home tiles and history scroll together. -->
                <Grid x:Name="ResultsViewport" Grid.Row="2" Margin="8,0,8,8">
                    <ListBox x:Name="ResultsList"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemTemplate="{StaticResource ResultTemplate}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             Visibility="{Binding IsHomeQuery, Converter={StaticResource InverseBoolToVisibility}}"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel" />

                    <ScrollViewer x:Name="HomeScroll"
                                  Visibility="{Binding IsHomeQuery, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False"
                                  PreviewMouseWheel="OnHomePreviewMouseWheel">
                        <StackPanel>
                            <!-- One compact icon row; horizontal overflow stays inside the shared home viewport. -->
                            <ScrollViewer x:Name="PinnedScroll"
                                          Margin="6,0,6,4"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          Visibility="{Binding ShowHomeTiles, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl x:Name="HomePinsList"
                                              ItemsSource="{Binding HomePins}"
                                              ItemTemplate="{StaticResource PinnedTileTemplate}"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Home history is bounded by the store; only HomeScroll owns vertical scrolling. -->
                            <ListBox x:Name="HomeHistoryList"
                                     ItemsSource="{Binding Results}"
                                     ItemTemplate="{StaticResource ResultTemplate}"
                                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     PreviewMouseLeftButtonDown="OnHomeHistoryPreviewMouseLeftButtonDown" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyResultsMessage}"
                               Margin="24"
                               MaxWidth="520"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowStateMessage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
